{
  "name": "tagmesh-markdown",
  "version": "1.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "wrangler dev worker/index.ts --ip 0.0.0.0",
    "worker:deploy": "wrangler deploy worker/index.ts",
    "db:init": "wrangler d1 execute tagmesh-db --file=./schema.sql --local",
    "db:init:remote": "wrangler d1 execute tagmesh-db --file=./schema.sql --remote"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@tailwindcss/vite": "^4.0.9",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.11.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^3.109.2"
  }
}
